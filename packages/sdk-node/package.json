{
  "name": "@agentkern/sdk",
  "version": "0.1.0",
  "description": "AgentKern SDK - Liability Proofs and Agent Cryptography for Node.js",
  "main": "index.js",
  "types": "index.d.ts",
  "author": "AgentKern Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentkern/agentkern"
  },
  "keywords": [
    "ai-agents",
    "cryptography",
    "liability",
    "sdk",
    "ed25519",
    "jwt",
    "a2a"
  ],
  "engines": {
    "node": ">= 18"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "name": "agentkern-sdk",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node test/index.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.5.1"
  }
}
